@startuml
title PayLink - Pay Bill Sequence Diagram

autonumber

actor Customer
participant "Mobile App" as App
participant "Payment Service" as Payment
participant "Wallet Service" as Wallet
participant "Biller" as Biller

Customer -> App: Pay bill
App -> Payment: Submit payment

Payment -> Payment: Validate request
Payment -> Wallet: Hold amount

alt Insufficient balance
    Wallet --> Payment: Hold rejected
    Payment -> Payment: Status = REJECTED
    Payment --> App: Payment rejected

else Balance available
    Wallet --> Payment: Funds held
    Payment -> Payment: Status = PROCESSING

    Payment -> Biller: Process bill payment

    alt Payment successful
        Biller --> Payment: Success
        Payment -> Wallet: Capture held funds
        Payment -> Payment: Status = SUCCESS
        Payment --> App: Payment successful

    else Payment failed
        Biller --> Payment: Failure
        Payment -> Wallet: Release held funds
        Payment -> Payment: Status = FAILED
        Payment --> App: Payment failed

    else Timeout
        Biller --> Payment: No confirmed result
        Payment -> Payment: Status = UNKNOWN
        Payment --> App: Payment pending verification
    end
end

App --> Customer: Display payment status

@enduml