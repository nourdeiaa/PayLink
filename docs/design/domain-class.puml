@startuml
title PayLink - Domain Class Diagram

skinparam classAttributeIconSize 0

' ==================== ENUMS ====================

enum PaymentStatus {
  INITIATED
  FUNDS_HELD
  SENT_TO_BILLER
  COMPLETED
  REJECTED
  FAILED
  UNKNOWN
  REFUNDED
}

enum EntryType {
  TOPUP
  HOLD
  HOLD_RELEASE
  CHARGE
  FEE_INCOME
  COMMISSION
  REFUND
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum FeeType {
  FIXED
  PERCENTAGE
  TIERED
}

' ==================== CLASSES ====================

class Customer {
  +id: int
  +name: string
  +phone: string
  +verificationLevel: string
}

class Wallet {
  +id: int
  +/availableBalance: decimal
  +/heldBalance: decimal
}

class LedgerEntry {
  +id: int
  +amount: decimal
  +entryType: EntryType
  +createdAt: datetime
}

class Payment {
  +id: int
  +reference: string
  +amount: decimal
  +fee: decimal
  +status: PaymentStatus
  +idempotencyKey: string
}

class Biller {
  +id: int
  +name: string
  +protocol: string
}

class Service {
  +id: int
  +name: string
  +active: boolean
}

class FeeRule {
  +id: int
  +feeType: FeeType
  +feeValue: decimal
  +isPromotion: boolean
  +startDate: date
  +endDate: date
}

class Agent {
  +id: int
  +name: string
}

class Hold {
  +id: int
  +amount: decimal
  +status: string
}

class Notification {
  +id: int
  +channel: string
  +status: string
  +retryCount: int
}

class Commission {
  +id: int
  +amount: decimal
  +status: CommissionStatus
}

' ==================== RELATIONSHIPS ====================

Customer "1" -- "1" Wallet : owns

Wallet "1" *-- "0..*" LedgerEntry : records

Customer "1" -- "0..*" Payment : makes

Wallet "1" -- "0..*" Payment : used for

Payment "0..*" -- "1" Service : pays for

Biller "1" -- "1..*" Service : provides

Service "1" -- "0..*" FeeRule : defines

Payment "1" -- "0..*" LedgerEntry : generates

Payment "1" -- "0..1" Commission : generates

Agent "1" -- "0..*" Commission : earns

Agent "0..1" -- "0..*" Payment : assists with

Agent "1" -- "1" Wallet : owns

Payment "1" -- "0..*" Hold : reserves funds
Wallet "1" -- "0..*" Hold : holds
Payment "1" -- "0..*" Notification : triggers

@enduml