@startuml
title PayLink - Refund Sequence Diagram

autonumber

actor Customer
actor "Support Employee" as Support

participant "Mobile App" as App
participant "Refund Service" as Refund
participant "Payment Service" as Payment
participant "Wallet Service" as Wallet

Customer -> App: Request refund
App -> Refund: Submit request

Refund -> Payment: Check payment eligibility

alt Payment not eligible
    Payment --> Refund: Not eligible
    Refund --> App: Reject request

else Payment eligible
    Payment --> Refund: Eligible
    Refund -> Refund: Create refund request (PENDING)

    Support -> Refund: Review request

    alt Refund rejected
        Refund -> Refund: Status = REJECTED
        Refund --> App: Refund rejected

    else Refund approved
        Refund -> Refund: Status = APPROVED
        Refund -> Payment: Set REFUND_PENDING
        Refund -> Wallet: Credit refund amount
        Wallet --> Refund: Credit successful
        Refund -> Refund: Status = PROCESSED
        Refund -> Payment: Set REFUNDED
        Refund --> App: Refund successful
    end
end

App --> Customer: Display refund status

@enduml